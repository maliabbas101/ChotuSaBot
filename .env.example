# --- Required -----------------------------------------------------------
DISCORD_TOKEN=

# --- Storage --------------------------------------------------------------
# Path to the JSON data file (created automatically on first run).
BOT_DATA_FILE=data/bot_data.json

# --- Gemini (AI chat replies, /tldr) --------------------------------------
# Optional. Leave all blank to run with AI features disabled — moderation,
# roles, and entertainment commands work fine without them. Fill in 2-4 keys
# to enable automatic rotation when a key gets rate-limited (HTTP 429).
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_MODEL=gemini-2.0-flash

# --- Optional external content API (trivia/riddles) ------------------------
# Leave blank to use the built-in static question bank instead.
API_NINJAS_KEY=

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO
# Optional path to also log to a file, e.g. logs/bot.log
LOG_FILE=
